# Copy this file to .env and adjust values for your local setup.
# Never commit a real .env file or real credentials/API keys.

# "file" (default, no DB needed) or "db" (PostgreSQL via SQLAlchemy)
KBA_TYPE_STORAGE=file

# Only needed when KBA_TYPE_STORAGE=db. DATABASE_URL (the convention
# most hosting platforms inject automatically for a provisioned
# Postgres instance) takes priority over these if both are set.
KBA_ENV=dev
KBA_DB_USER=kba_dev
KBA_DB_PWD=kba_dev_pwd
KBA_DB_HOST=localhost
KBA_DB_NAME=kba_dev_db
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Set to "true" to have the app seed starter regions/cities on boot if
# they don't already exist — useful on hosts without reliable shell
# access to run seed_data.py manually after deploying. Leave unset for
# local dev if you'd rather run seed_data.py yourself.
KBA_AUTO_SEED=false

# Flask API server
KBA_API_HOST=0.0.0.0
KBA_API_PORT=5000

# Signs session cookies. Required for real use — without it, each
# process start (and each gunicorn worker) gets a different random key,
# which breaks logins unpredictably. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
KBA_SECRET_KEY=

# Session cookie attributes. Defaults (Lax, not Secure) work for local
# dev where the frontend and API share "localhost" as their site. If
# frontend and API are deployed on different sites (e.g. different
# subdomains), set SAMESITE=None and SECURE=true — both are required
# together, and Secure requires HTTPS.
KBA_COOKIE_SAMESITE=Lax
KBA_COOKIE_SECURE=false

# Comma-separated list of frontend origin(s) allowed to make credentialed
# (cookie-carrying) requests to this API. Defaults to the local dev
# frontend if unset.
KBA_FRONTEND_ORIGIN=http://localhost:8000,http://127.0.0.1:8000

# Bootstraps the first admin account on boot, if no user with this email
# exists yet (idempotent — safe to leave set across restarts). Every
# other admin/account is then created and managed through the account
# system itself (POST /api/v1/auth/register, then promoted manually).
KBA_ADMIN_EMAIL=
KBA_ADMIN_PASSWORD=
KBA_ADMIN_NAME=Admin

# Sends the email-verification link (registration) and password-reset
# code, via the Resend API (resend.com — sign up, then Dashboard ->
# API Keys). HTTP-based rather than SMTP on purpose: PaaS hosts
# commonly block or restrict outbound SMTP ports (25/465/587) on
# free/starter tiers, while leaving outbound HTTPS open. Leave unset
# for local dev: emails just get printed to the console instead of
# sent, so registration/verification/reset are still fully testable
# without a real account.
RESEND_API_KEY=
# Defaults to Resend's own "onboarding@resend.dev" sender, which works
# without verifying a custom domain — fine for getting started, but
# swap in your own domain's address once you've verified one with
# Resend for anything beyond testing.
RESEND_FROM=
