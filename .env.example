# Copy this file to .env and adjust values for your local setup.
# Never commit a real .env file or real credentials/API keys.

# "file" (default, no DB needed) or "db" (MySQL via SQLAlchemy)
KBA_TYPE_STORAGE=file

# Only needed when KBA_TYPE_STORAGE=db
KBA_ENV=dev
KBA_MYSQL_USER=kba_dev
KBA_MYSQL_PWD=kba_dev_pwd
KBA_MYSQL_HOST=localhost
KBA_MYSQL_DB=kba_dev_db

# Flask API server
KBA_API_HOST=0.0.0.0
KBA_API_PORT=5000

# Optional: if set, POST/PUT/DELETE require a matching X-API-Key header.
# Leave unset for local dev. Set this before deploying anywhere public.
KBA_API_KEY=
